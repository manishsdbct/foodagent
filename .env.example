# Environment variables the app reads. It does not load a .env file: export them in your shell,
# e.g. `set -a; source .env; set +a` after copying this file to .env (which git ignores).
# Everything is optional: without ANTHROPIC_API_KEY the app runs the offline rule agent.

ANTHROPIC_API_KEY=
ANTHROPIC_AGENT_MODEL=claude-opus-5
ANTHROPIC_AGENT_EFFORT=low
# "fast" = Opus fast mode (premium pricing; falls back to standard if the account has no fast-mode quota)
ANTHROPIC_AGENT_SPEED=
ANTHROPIC_MODEL=claude-haiku-4-5

DATABASE_URL=postgresql://localhost/foodagent
TEST_DATABASE_URL=postgresql://localhost/foodagent_test

# Comma-separated saved payment methods the mock gateway declines, e.g. "saved UPI"
FOODAGENT_DECLINE_PAYMENTS=
